{
  "description": "quest-log: brief Claude on the log protocol at session start, record each prompt as an ask, notice unlogged edits and commits, and show log changes in the terminal; with the overlay setting on, draw the log inside Claude Code (hooks module overlay.tsx).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/skills/quests/quest.py hook-session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/skills/quests/quest.py hook-prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/skills/quests/quest.py hook-post-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/skills/quests/quest.py hook-stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": [
    "./overlay.tsx"
  ]
}
